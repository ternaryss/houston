package views

import "github.com/ternaryss/houston/views/components"

templ Index(count int) {
	<!DOCTYPE html>
	<html lang="en">
		@Header()
		<body>
			<div class="container mx-auto mt-14">
				<h1 class="text-base-content text-4xl text-center">Hello World!</h1>
				@components.Counter(count)
			</div>
		</body>
	</html>
}
