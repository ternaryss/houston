package components

import (
	"fmt"
	"github.com/ternaryss/houston/internal/app/types"
)

func action(id, mod string) string {
	if mod == types.EditMode {
		return fmt.Sprintf(`hx-put=/web-apps/%s`, id)
	}

	return `hx-post=/web-apps`
}

templ WebAppForm(frm types.WebAppForm, mod string) {
	<form id="webAppForm" { action(frm.Id, mod) } hx-target="#webAppForm" hx-swap="outerHTML" class="mx-auto container">
		<div class="flex items-center justify-between px-4">
			if mod == types.EditMode {
				<h3 class="text-base-content text-2xl truncate max-w-full">Edit application</h3>
			} else {
				<h3 class="text-base-content text-2xl truncate max-w-full">Add application</h3>
			}
			<div class="flex gap-2 shrink-0">
				if mod == types.EditMode {
					<a href={ fmt.Sprintf("/web-apps/%s", frm.Id) } class="btn btn-square btn-secondary">
						<span class="icon-[tabler--x]"></span>
					</a>
				} else {
					<a href="/" class="btn btn-square btn-secondary">
						<span class="icon-[tabler--x]"></span>
					</a>
				}
				<button type="submit" class="btn btn-square btn-primary">
					<span class="icon-[tabler--device-floppy]"></span>
				</button>
			</div>
		</div>
		<hr class="my-4"/>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4 px-4 max-w-3xl mx-auto w-full">
			<div class="col-span-2">
				<div class="input-group w-full">
					<div class="relative w-full">
						<input id="name" name="name" type="text" placeholder="Name" value={ frm.Name } class={ fmt.Sprintf("input input-floating peer %s", errorClass("name", frm.Errors)) } required/>
						<label for="name" class="input-floating-label">Name</label>
					</div>
					<span class="input-group-text">
						<span class="icon-[tabler--letter-a] text-base-content/80 size-5"></span>
					</span>
				</div>
				if isFieldInvalid("name", frm.Errors) {
					@FieldError(frm.Errors["name"])
				}
			</div>
			<div class="col-span-2">
				<div class="input-group w-full">
					<div class="relative w-full">
						<input id="url" name="url" type="text" placeholder="URL" value={ frm.Url } class={ fmt.Sprintf("input input-floating peer %s", errorClass("url", frm.Errors)) } required/>
						<label for="url" class="input-floating-label">URL</label>
					</div>
					<span class="input-group-text">
						<span class="icon-[tabler--planet] text-base-content/80 size-5"></span>
					</span>
				</div>
				if isFieldInvalid("url", frm.Errors) {
					@FieldError(frm.Errors["url"])
				}
			</div>
			<div class="col-span-2 md:col-span-1">
				<div class="input-group w-full">
					<div class="relative w-full">
						<input id="status" name="status" type="text" placeholder="Status HTTP" value={ frm.Status } class={ fmt.Sprintf("input input-floating peer %s", errorClass("status", frm.Errors)) } required/>
						<label for="status" class="input-floating-label">Status HTTP</label>
					</div>
					<span class="input-group-text">
						<span class="icon-[tabler--activity-heartbeat] text-base-content/80 size-5"></span>
					</span>
				</div>
				if isFieldInvalid("status", frm.Errors) {
					@FieldError(frm.Errors["status"])
				}
			</div>
			<div class="col-span-2 md:col-span-1">
				<div class="input-group w-full">
					<div class="relative w-full">
						<select id="interval" name="interval" class={ fmt.Sprintf("select select-floating %s", errorClass("interval", frm.Errors)) }>
							<option disabled selected>Select...</option>
							for _, i := range types.Intervals {
								if i == frm.Interval {
									<option selected>{ i }</option>
								} else {
									<option>{ i }</option>
								}
							}
						</select>
						<label for="interval" class="select-floating-label">Interval</label>
					</div>
				</div>
				if isFieldInvalid("interval", frm.Errors) {
					@FieldError(frm.Errors["interval"])
				}
			</div>
			<div class="col-span-2">
				@NotifyForm(frm)
			</div>
		</div>
	</form>
}
