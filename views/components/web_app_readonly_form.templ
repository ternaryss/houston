package components

import "github.com/ternaryss/houston/internal/app/types"
import "fmt"

templ WebAppReadonlyForm(app *types.WebApp) {
	<div class="mx-auto container">
		<div class="flex items-center justify-between px-4">
			<h3 class="text-base-content text-2xl truncate max-w-full">Application</h3>
			<div class="flex gap-2 shrink-0">
				<a href="/" class="btn btn-square btn-secondary">
					<span class="icon-[tabler--x]"></span>
				</a>
				<button type="button" hx-delete={ fmt.Sprintf("/web-apps/%s", app.Id) } hx-trigger="click" hx-include="none" class="btn btn-square btn-error">
					<span class="icon-[tabler--trash]"></span>
				</button>
				<a href={ fmt.Sprintf("/web-apps/%s/edit", app.Id) } class="btn btn-square btn-primary">
					<span class="icon-[tabler--pencil]"></span>
				</a>
			</div>
		</div>
		<hr class="my-4"/>
		<form class="grid grid-cols-1 md:grid-cols-2 gap-4 px-4 max-w-3xl mx-auto w-full">
			<div class="col-span-2">
				<div class="input-group w-full">
					<div class="relative w-full">
						<input id="name" name="name" type="text" placeholder="Name" value={ app.Name } class="input input-floating peer" readonly/>
						<label for="name" class="input-floating-label">Name</label>
					</div>
					<span class="input-group-text">
						<span class="icon-[tabler--letter-a] text-base-content/80 size-5"></span>
					</span>
				</div>
			</div>
			<div class="col-span-2">
				<div class="input-group w-full">
					<div class="relative w-full">
						<input id="url" name="url" type="text" placeholder="URL" value={ app.Url } class="input input-floating peer" readonly/>
						<label for="url" class="input-floating-label">URL</label>
					</div>
					<span class="input-group-text">
						<span class="icon-[tabler--planet] text-base-content/80 size-5"></span>
					</span>
				</div>
			</div>
		</form>
	</div>
}
