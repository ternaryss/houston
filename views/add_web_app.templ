package views

import "github.com/ternaryss/houston/views/components"
import "github.com/ternaryss/houston/internal/app/types"

templ AddWebApp(usr string, frm types.WebAppForm) {
	<div class="flex flex-col min-h-screen">
		@components.Navigation(usr)
		<main class="flex-grow px-6 py-4">
			@components.WebAppForm(frm)
		</main>
		@components.Footer()
	</div>
}
